---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getDocsNavigation } from "@/lib/docs/navigation";

const sections = await getDocsNavigation();

/* ========================================
   SAFE SORT (не мутируем)
======================================== */

const sortedSections = [...sections].sort(
  (a, b) => a.order - b.order
);

/* ========================================
   FLAT FLOW
======================================== */

const flatDocs = sortedSections.flatMap((section) =>
  [...section.items].sort((a, b) => a.order - b.order)
);

const first = flatDocs[0];
---

<DocsLayout
  headings={[]}
  title="Vedana Docs"
>
  <div class="docs-home">

    <section class="hero">
      <h1>Vedana</h1>

      <p class="lead">
        Vedana is a configurable Semantic RAG system that answers questions over structured business knowledge 
        by combining data-model-aware reasoning, graph queries, and semantic vector search.
      </p>

      {first && (
        <a class="start-button" href={first.href}>
          Start →
        </a>
      )}
    </section>

    <section class="sections">
      {sortedSections.map((section) => (
        <div class="section">
          <h3>{section.title}</h3>

          <ul>
            {[...section.items]
              .sort((a, b) => a.order - b.order)
              .map((item) => (
                <li>
                  <a href={item.href}>
                    {item.title}
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))}
    </section>

  </div>
</DocsLayout>