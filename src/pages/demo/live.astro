---
import BaseLayout from "@/layouts/baseLayout.astro";

import { SEOBase } from "@content/vedana/seo/seo";
import type { SEOConfig } from "@/lib/seo/types";

import { questionTypeFilters, benchmarkQuestions } from "@/content/demo/benchmark";
import { getCollection } from "astro:content";

const corpusDocs = await getCollection("corpus");
const lawCount = corpusDocs.filter((d) => d.data.type === "law").length;
const regCount = corpusDocs.filter((d) => d.data.type === "reg").length;
const caseCount = corpusDocs.filter((d) => d.data.type === "case").length;
const corpusIds = corpusDocs.map((d) => d.id);

import "../../styles/global.css";
import "@/styles/vedana/extra-tokens.css";
import "@/styles/vedana/demo.css";

// This page is the "private demo" chat from the DIFC deck (pages 9–13).
// The UI is ours, 1:1 with the mockups; the answers come from the
// jims-widget server API. Access control lives on that server: the page
// reads ?token= from the URL and passes it with every call — the server
// decides whether the token is valid and how many questions are left.
const pageSEO: Partial<SEOConfig> = {
  title: "Your private demo – Vedana",
  description: "Ask Vedana anything about the DIFC legal corpus, live.",
  canonical: "https://vedana.tech/demo/live",
  noindex: true,
};

const typeIcons: Record<string, string> = {
  trap: "⚠️",
  "cross-case": "🔗",
  article: "📄",
  "court-fact": "⚖️",
  chronological: "📈",
  "law-structure": "☰",
};

const typeMeta: Record<string, string> = {
  trap: "concepts DIFC doesn't have",
};
---

<BaseLayout baseSEO={SEOBase} pageSEO={pageSEO} showNav={false}>
  <div class="lv-page">
    <script type="application/json" id="lv-corpus-ids" set:html={JSON.stringify(corpusIds)} />

    <!-- Branded top bar (mockup p.9): client badge · powered by Vedana · quota pill -->
    <header class="lv-bar">
      <div class="lv-bar__inner">
        <span class="lv-bar__client" id="lv-client">Al Tamimi &amp; Co</span>
        <span class="lv-bar__sub" id="lv-mode">private demo · powered by <a href="/demo">Vedana</a></span>
        <span class="lv-bar__quota" id="lv-quota"><span class="lv-bar__dot"></span><span id="lv-quota-text">… questions</span></span>
      </div>
    </header>

    <div class="lv-container">
      <div id="lv-no-token" class="lv-no-token" hidden>
        <span class="lv-no-token__text">
          This page is meant to be opened from a personal link — it needs a
          <code>?token=</code> in the URL to unlock live answers.
        </span>
        <a href="/demo/contact">Request a live link →</a>
      </div>

      <!-- ============ SCREEN: START (p.9) ============ -->
      <section id="lv-start">
        <div class="lv-hero">
          <div class="demo-badge">
            <span class="demo-badge__dot"></span>
            Your private demo
          </div>
          <h1 class="lv-hero__title">Hi <span id="lv-client-inline">Al Tamimi &amp; Co</span> — this is Vedana, live on DIFC law</h1>
          <p class="lv-hero__lead">
            <strong>Vedana turns a document set into a knowledge graph</strong>,
            so answers are grounded in the source instead of guessed. This demo
            runs on the DIFC legal corpus from the
            <strong>Agentic RAG Challenge</strong> — laws, regulations and
            court decisions. Ask it anything and watch it work.
          </p>
        </div>

        <div class="lv-summary">
          <div class="lv-summary__card">
            <p class="lv-summary__title">📚 The corpus</p>
            <div class="lv-summary__stats">
              <div><strong>{lawCount}</strong><span>Laws</span></div>
              <div><strong>{regCount}</strong><span>Regs</span></div>
              <div><strong>{caseCount}</strong><span>Decisions</span></div>
            </div>
            <p class="lv-summary__links">
              <a href="/demo/corpus">Browse the corpus →</a>
              <a href="/demo/data-model">Data model →</a>
            </p>
          </div>

          <div class="lv-summary__card">
            <p class="lv-summary__title">≡ The question set</p>
            <div class="lv-summary__stats">
              <div><strong>93</strong><span>Questions</span></div>
              <div><strong>6</strong><span>Types</span></div>
              <div><strong class="lv-summary__key">key</strong><span>Answer set</span></div>
            </div>
            <p class="lv-summary__note">Each answer checked against the official key.</p>
          </div>
        </div>

        <p class="lv-pick-label"><strong>Pick a question</strong> <span>by type · tap a type to open · tap a question to run</span></p>

        <div class="lv-question-set">
          {questionTypeFilters
            .filter((f) => f.key !== "all")
            .map((f) => (
              <div class="lv-qtype" data-key={f.key}>
                <button type="button" class="lv-qtype__head">
                  <span>
                    {typeIcons[f.key]} <strong>{f.label}{f.key === "trap" ? " questions" : f.key === "cross-case" ? " comparison" : ""}</strong>
                    {typeMeta[f.key] && <em class="lv-qtype__meta">{typeMeta[f.key]}</em>}
                  </span>
                  <span class="lv-qtype__count">{f.count} <span class="lv-qtype__chevron">›</span></span>
                </button>
                <div class="lv-qtype__body" hidden>
                  {benchmarkQuestions
                    .filter((q) => q.type === f.key)
                    .map((q) => (
                      <button type="button" class="lv-qtype__question" data-question={q.question} data-type-label={q.typeLabel}>
                        <span class="lv-qtype__play">▶</span> {q.question}
                      </button>
                    ))}
                  {benchmarkQuestions.filter((q) => q.type === f.key).length === 0 && (
                    <p class="lv-qtype__empty">Sample questions load with the full question set.</p>
                  )}
                </div>
              </div>
            ))}
        </div>

        <div class="lv-divider"><span>or ask your own</span></div>

        <form class="lv-composer" id="lv-composer-start">
          <span class="lv-composer__icon">💬</span>
          <input type="text" placeholder="Ask anything about the DIFC corpus…" autocomplete="off" />
          <button type="submit" class="lv-composer__send" aria-label="Send">↑</button>
        </form>

        <p class="demo-footnote">
          Free-form questions use 1 of your questions.
        </p>
      </section>

      <!-- ============ SCREEN: CHAT (p.11–12) ============ -->
      <section id="lv-chat" hidden>
        <div class="lv-thread" id="lv-thread"></div>

        <form class="lv-composer lv-composer--chat" id="lv-composer-chat">
          <button type="button" class="lv-composer__qset" id="lv-back-to-set">≡ Question set</button>
          <input type="text" placeholder="…or ask a follow-up" autocomplete="off" />
          <button type="submit" class="lv-composer__send" aria-label="Send">↑</button>
        </form>
      </section>

      <!-- ============ SCREEN: LIMIT REACHED (p.13) ============ -->
      <section id="lv-done" class="lv-done" hidden>
        <div class="lv-done__check">✓</div>
        <h2 class="lv-done__title">That's all <span id="lv-done-total">12</span> questions on this link</h2>
        <p class="lv-done__lead">
          Hope it showed what grounded, graph-based answers look like on a
          real legal corpus. Want to see it on <strong>your own documents</strong>?
        </p>
        <a href="/demo/contact" class="lv-done__cta">Book a call →</a>
        <p class="lv-done__links">
          Prefer to keep exploring? The <a href="/demo/corpus">corpus</a>,
          <a href="/demo/data-model">data model</a> and
          <a href="/demo/vedana-chatgpt">ChatGPT comparison</a> stay open.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .lv-page {
    min-height: 100vh;
    background: var(--color-bg-muted);
  }

  /* ---------- top bar ---------- */

  .lv-bar {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .lv-bar__inner {
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .lv-bar__client {
    background: var(--color-ink, #0b1830);
    color: #fff;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .lv-bar__sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  .lv-bar__sub a {
    color: var(--color-primary-ink);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .lv-bar__quota {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-primary-ink);
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    white-space: nowrap;
  }

  .lv-bar__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-signal, #22d3ee);
  }

  .lv-container {
    max-width: 46rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-10);
  }

  .lv-no-token {
    background: var(--color-signal-soft);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    font-size: var(--font-size-sm);
    color: var(--color-primary-ink);
    margin-bottom: var(--space-5);
  }

  .lv-no-token code {
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.6);
    padding: 1px 4px;
    border-radius: 3px;
  }

  /* ---------- start screen ---------- */

  .lv-hero {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin-bottom: var(--space-5);
  }

  .lv-hero__title {
    font-size: var(--heading-2-size);
    margin: var(--space-3) 0;
    color: var(--color-text-strong);
  }

  .lv-hero__lead {
    margin: 0;
    color: var(--color-text-muted);
  }

  .lv-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (max-width: 640px) {
    .lv-summary {
      grid-template-columns: 1fr;
    }
  }

  .lv-summary__card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .lv-summary__title {
    margin: 0 0 var(--space-4);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-strong);
  }

  .lv-summary__stats {
    display: flex;
    gap: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .lv-summary__stats div {
    display: flex;
    flex-direction: column;
  }

  .lv-summary__stats strong {
    font-size: var(--font-size-xl);
    color: var(--color-text-strong);
  }

  .lv-summary__key {
    color: var(--color-success) !important;
  }

  .lv-summary__stats span {
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  .lv-summary__links {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .lv-summary__links a {
    color: var(--color-primary-ink);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .lv-summary__note {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  .lv-pick-label {
    color: var(--color-text-strong);
    margin-bottom: var(--space-3);
  }

  .lv-pick-label span {
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
  }

  .lv-question-set {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .lv-qtype {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .lv-qtype__head {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    background: none;
    border: none;
    cursor: pointer;
    font-size: var(--font-size-base);
    color: var(--color-text-strong);
    text-align: left;
  }

  .lv-qtype__meta {
    font-style: normal;
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
    margin-left: var(--space-2);
  }

  .lv-qtype.is-open {
    border-color: var(--color-primary-border);
  }

  .lv-qtype.is-open .lv-qtype__head {
    background: var(--color-primary-soft);
    color: var(--color-primary-ink);
  }

  .lv-qtype__count {
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }

  .lv-qtype__body {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
    padding: var(--space-2);
    gap: var(--space-1);
  }

  .lv-qtype__question {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    text-align: left;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-muted);
    border: none;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    cursor: pointer;
  }

  .lv-qtype__question:hover {
    background: var(--color-primary-soft);
  }

  .lv-qtype__question:disabled {
    opacity: 0.5;
    cursor: default;
    background: var(--color-bg-muted);
  }

  .lv-qtype__play {
    color: var(--color-primary);
    font-size: 0.625rem;
  }

  .lv-qtype__empty {
    padding: var(--space-2) var(--space-4);
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  .lv-divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-3);
  }

  .lv-divider::before,
  .lv-divider::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--color-border);
  }

  /* ---------- composer ---------- */

  .lv-composer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
  }

  .lv-composer:focus-within {
    border-color: var(--color-primary-border);
  }

  .lv-composer__icon {
    font-size: var(--font-size-sm);
  }

  .lv-composer input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font-size: var(--font-size-base);
    color: var(--color-text);
    min-width: 0;
  }

  .lv-composer input::placeholder {
    color: var(--color-text-subtle);
  }

  .lv-composer__send {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--font-size-base);
    cursor: pointer;
  }

  .lv-composer__send:hover {
    background: var(--color-primary-hover);
  }

  .lv-composer__send:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .lv-composer__qset {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    border: 1px solid var(--color-primary-border);
    background: var(--color-primary-soft);
    color: var(--color-primary-ink);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }

  /* ---------- thread (answer cards, p.11–12) ---------- */

  .lv-thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-4);
  }

  :global(.lv-msg-user) {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-3);
  }

  :global(.lv-msg-user__chip) {
    font-size: var(--font-size-xs, 0.75rem);
    color: var(--color-text-subtle);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 2px var(--space-3);
    white-space: nowrap;
  }

  :global(.lv-msg-user__bubble) {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-strong);
    max-width: 34rem;
  }

  :global(.lv-msg-vedana__head) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  :global(.lv-msg-vedana__avatar) {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-bold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  :global(.lv-msg-vedana__name) {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  :global(.lv-msg-vedana__verdict) {
    margin-left: auto;
  }

  :global(.lv-msg-vedana__body) {
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  :global(.lv-msg-vedana__sources) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
    margin: 0 0 var(--space-3);
  }

  :global(.lv-msg-vedana__sources-label) {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  :global(.lv-msg-vedana__sources a) {
    color: var(--color-primary-ink);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  :global(.lv-official) {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-3);
  }

  :global(.lv-official__label) {
    display: block;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin: 0 0 var(--space-2);
    cursor: pointer;
    list-style: none;
  }

  :global(.lv-official__label::-webkit-details-marker) {
    display: none;
  }

  :global(.lv-official__text) {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  :global(.lv-chatgpt) {
    border: 1px solid var(--color-border);
    background: var(--color-bg-muted);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-3);
  }

  :global(.lv-chatgpt__head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  :global(.lv-chatgpt__diff) {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  :global(.lv-chatgpt__diff strong) {
    color: var(--color-text-muted);
  }

  :global(.lv-trace) {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-3);
  }

  :global(.lv-trace summary) {
    padding: var(--space-3) var(--space-5);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
  }

  :global(.lv-trace summary::before) {
    content: "› ";
    color: var(--color-text-subtle);
  }

  :global(.lv-trace[open] summary::before) {
    content: "⌄ ";
  }

  :global(.lv-trace__body) {
    padding: 0 var(--space-5) var(--space-4);
    font-size: var(--font-size-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    white-space: pre-wrap;
  }

  :global(.lv-msg-actions) {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  :global(.lv-msg-actions button) {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
  }

  :global(.lv-msg-actions button:hover) {
    border-color: var(--color-primary-border);
    color: var(--color-primary-ink);
  }

  :global(.lv-thinking) {
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
  }

  :global(.lv-error) {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-sm);
  }

  /* ---------- limit screen (p.13) ---------- */

  .lv-done {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-10) var(--space-6);
    text-align: center;
  }

  .lv-done__check {
    width: 3rem;
    height: 3rem;
    margin: 0 auto var(--space-4);
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary-ink);
    font-size: var(--font-size-xl);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lv-done__title {
    margin: 0 0 var(--space-3);
    font-size: var(--heading-2-size);
    color: var(--color-text-strong);
  }

  .lv-done__lead {
    max-width: 30rem;
    margin: 0 auto var(--space-5);
    color: var(--color-text-muted);
  }

  .lv-done__cta {
    display: inline-flex;
    padding: var(--space-3) var(--space-6);
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }

  .lv-done__cta:hover {
    background: var(--color-primary-hover);
  }

  .lv-done__links {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  .lv-done__links a {
    color: var(--color-primary-ink);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }
</style>

<script>
  import { benchmarkQuestions } from "@/content/demo/benchmark";

  /* ======================================================
     API adapter — the only place that talks to the jims-widget
     server. Protocol (read from /static/jims-widget.js):

       WS   wss://{SERVER}/ws/chat?contact_id={contactId}&token={token}
            send    {"messages":[{"role":"user","text":"…"}]}
            receive {"type":"message"|"sync","parts":[{text|html|error}…],"cursor":N}
                    or {"type":"error","error":"…"}
       GET  {SERVER}/api/history?contact_id={contactId}&token={token}

     `token` is the personal access token from the emailed link — it is what the
     server checks against Epoch Gate, nothing else. `contact_id` is unrelated: the
     server requires it to match `widget:<uuid>` and uses it only to key the thread
     (see WIDGET_CONTACT_ID_RE / _claim_socket in jims_widget/server.py). We mint one
     ourselves per tab and keep it in sessionStorage — NOT localStorage, or two tabs
     on the same link would fight over the single live socket the server allows per
     contact_id.

     The server has no quota or client-name concept, so both
     live on this page: quota counts down in localStorage per
     token; the client name comes from ?client=. The official
     answer for questions from the set is local benchmark data.

     ?mock=1 answers locally so the whole flow can be clicked
     through without a server (the real server sits behind SSO).
  ====================================================== */

  const SERVER = "https://jims-widget.demo.e8.ai.epoch8.dev";
  const QUOTA_TOTAL = 12;

  const params = new URLSearchParams(window.location.search);
  const token = params.get("token");
  const mock = params.get("mock") === "1";
  const clientName = params.get("client") ?? "Al Tamimi & Co";

  function widgetContactId(): string {
    const key = `lv-contact:${token ?? "mock"}`;
    let id = sessionStorage.getItem(key);
    if (!id) {
      id = `widget:${crypto.randomUUID()}`;
      sessionStorage.setItem(key, id);
    }
    return id;
  }

  const contactId = widgetContactId();

  type Answer = {
    answer: string;
    html?: string;
    verdict?: "PASS" | "FAIL";
    official_answer?: string;
    trace?: string;
    chatgpt?: { answer: string; verdict: "PASS" | "PARTIAL" | "FAIL"; comment: string };
    questions_left: number;
  };

  // Corpus doc ids for turning case references in an answer ("ARB 032/2025") into
  // links to /demo/corpus/<slug> — the server doesn't return source doc ids, so we
  // detect them from the text itself against the real corpus list built at build time.
  const corpusIds: string[] = JSON.parse(document.getElementById("lv-corpus-ids")!.textContent || "[]");
  const corpusIdSet = new Set(corpusIds);
  const CASE_REF_RE = /\b(ARB|CFI|CA|SCT|ENF|TCD|DEC)[\s-]?(\d{3})[\/-](\d{4})\b/gi;

  function extractSources(...texts: (string | undefined)[]): { slug: string; label: string }[] {
    const found = new Map<string, string>();
    for (const text of texts) {
      if (!text) continue;
      for (const m of text.matchAll(CASE_REF_RE)) {
        const [, type, num, year] = m;
        const slug = `${type.toLowerCase()}-${num}-${year}`;
        if (corpusIdSet.has(slug) && !found.has(slug)) {
          found.set(slug, `${type.toUpperCase()} ${num}/${year}`);
        }
      }
    }
    return [...found.entries()].map(([slug, label]) => ({ slug, label }));
  }

  const quotaKey = `lv-quota:${token ?? "mock"}`;

  function quotaLeft(): number {
    const raw = localStorage.getItem(quotaKey);
    return raw === null ? QUOTA_TOTAL : Math.max(0, parseInt(raw, 10) || 0);
  }

  function quotaSpend(): number {
    const left = Math.max(0, quotaLeft() - 1);
    localStorage.setItem(quotaKey, String(left));
    return left;
  }

  /* ---- websocket: auto-reconnect + guaranteed delivery ----
     Mirrors /static/jims-widget.js. Handles the same production failure mode: the socket dies
     while the server is generating an answer. The answer is still produced and stored
     server-side, but the send is lost — so on reconnect we ask the server (a "jims_sync" frame)
     for any assistant parts past `seenCount`, and keep polling while an answer is outstanding,
     instead of just failing the request. A dropped connection is not itself an error; only the
     overall ANSWER_TIMEOUT_MS gives up. */
  const RECONNECT_MIN_MS = 1000;
  const RECONNECT_MAX_MS = 15000;
  const SYNC_POLL_MS = 2500;
  const ANSWER_TIMEOUT_MS = 90000;
  // A bad token makes the server reject the handshake every single time, before the
  // socket ever opens — a real network blip is far less likely to fail that
  // consistently. Give up early on that specific pattern instead of silently
  // reconnecting for the full 90s and then blaming "the server".
  const MAX_HANDSHAKE_FAILURES = 2;

  let ws: WebSocket | null = null;
  let reconnectDelay = RECONNECT_MIN_MS;
  let consecutiveHandshakeFailures = 0;
  let seenCount = 0; // assistant-parts cursor, used to catch up after a reconnect
  let pending = false; // a question is awaiting its answer (across any number of reconnects)
  const outbox: string[] = []; // queued sends not yet delivered to an OPEN socket
  type ToolCallMeta = { cypher_queries?: string[]; vts_queries?: string[]; tool_calls?: unknown[] };
  type AskResult = { texts: string[]; meta?: ToolCallMeta[] };
  let waiter: { resolve: (result: AskResult) => void; reject: (e: Error) => void } | null = null;
  let waiterTimeout: ReturnType<typeof setTimeout> | null = null;
  let syncTimer: ReturnType<typeof setInterval> | null = null;

  function stopSyncPolling() {
    if (syncTimer) {
      clearInterval(syncTimer);
      syncTimer = null;
    }
  }

  function sendSync(socket: WebSocket) {
    if (socket.readyState === WebSocket.OPEN) {
      socket.send(JSON.stringify({ type: "jims_sync", cursor: seenCount }));
    }
  }

  function startSyncPolling(socket: WebSocket) {
    if (syncTimer) return;
    syncTimer = setInterval(() => {
      if (!pending) {
        stopSyncPolling();
        return;
      }
      sendSync(socket);
    }, SYNC_POLL_MS);
  }

  function settleWaiter(fn: "resolve" | "reject", value: AskResult | Error) {
    stopSyncPolling();
    if (waiterTimeout) {
      clearTimeout(waiterTimeout);
      waiterTimeout = null;
    }
    pending = false;
    outbox.length = 0;
    const w = waiter;
    waiter = null;
    if (fn === "resolve") w?.resolve(value as AskResult);
    else w?.reject(value as Error);
  }

  function ensureConnected() {
    if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) return;
    ws = connectWs();
  }

  function connectWs(): WebSocket {
    const wsUrl = `${SERVER.replace(/^https/, "wss")}/ws/chat?contact_id=${encodeURIComponent(contactId)}&token=${encodeURIComponent(token ?? "")}&with_meta=true`;
    const socket = new WebSocket(wsUrl);
    let opened = false;

    socket.onopen = () => {
      opened = true;
      reconnectDelay = RECONNECT_MIN_MS;
      consecutiveHandshakeFailures = 0;
      // Flush anything typed while offline (it never reached the server, so no duplicate risk).
      while (outbox.length && socket.readyState === WebSocket.OPEN) socket.send(outbox.shift()!);
      // Pull any answer produced while we were away, and keep polling until it arrives.
      if (pending) {
        sendSync(socket);
        startSyncPolling(socket);
      }
    };

    socket.onmessage = (event) => {
      let payload: any = event.data;
      try {
        payload = JSON.parse(event.data);
      } catch {}

      if (payload && typeof payload.cursor === "number") seenCount = payload.cursor;
      if (!waiter) return;

      if (payload && payload.type === "error") {
        const serverError = String(payload.error || "server error");
        // The server enforces its own real request budget per token, separate from
        // (and independent of) the client-side quota counter this page keeps in
        // localStorage — that counter is purely cosmetic and never actually checked
        // by the server. When the real budget runs out, say so plainly instead of
        // showing the generic "couldn't reach the server" message.
        settleWaiter("reject", new Error(/budget/i.test(serverError) ? "budget-exceeded" : serverError));
        return;
      }

      const parts = Array.isArray(payload?.parts) ? payload.parts : [payload];
      const texts = parts
        .map((p: any) => (typeof p === "string" ? p : p?.text ?? p?.html ?? ""))
        .filter(Boolean);
      // Empty parts (e.g. a sync poll before the answer is ready) just means "keep waiting".
      if (texts.length) settleWaiter("resolve", { texts, meta: payload?.meta });
    };

    socket.onclose = () => {
      if (ws !== socket) return; // superseded by a newer socket
      ws = null;
      stopSyncPolling();
      if (!pending) return;

      if (!opened) {
        consecutiveHandshakeFailures++;
        if (consecutiveHandshakeFailures >= MAX_HANDSHAKE_FAILURES) {
          settleWaiter("reject", new Error("invalid-token"));
          return;
        }
      }

      const delay = reconnectDelay;
      reconnectDelay = Math.min(reconnectDelay * 2, RECONNECT_MAX_MS);
      setTimeout(() => {
        if (pending) ensureConnected();
      }, delay);
    };

    socket.onerror = () => {
      try {
        socket.close();
      } catch {
        /* already closed */
      }
    };

    return socket;
  }

  // The server only sends this when the WS URL carries `with_meta=true` (connectWs
  // below) — real Cypher/vector-search queries the pipeline actually ran for this
  // question, not a lookup against the offline benchmark set. Works for any question,
  // not just the 93 pre-recorded ones.
  function metaToTrace(meta: ToolCallMeta[] | undefined): string | undefined {
    if (!meta || !meta.length) return undefined;
    const lines: string[] = [];
    for (const m of meta) {
      for (const q of m.vts_queries ?? []) lines.push(`vector search  ${q}`);
      for (const q of m.cypher_queries ?? []) lines.push(`cypher  ${q}`);
    }
    return lines.length ? lines.join("\n") : undefined;
  }

  async function apiAsk(question: string): Promise<Answer> {
    const known = benchmarkQuestions.find((q) => q.question === question);

    if (mock) {
      await new Promise((r) => setTimeout(r, 700));
      if (known) {
        return {
          answer: known.vedana.answer,
          verdict: known.vedana.verdict,
          official_answer: known.official,
          trace: known.vedana.trace,
          chatgpt: known.chatgpt,
          questions_left: quotaSpend(),
        };
      }
      return {
        answer:
          "Mock mode answers only questions from the set — open one from the list, or use a personal link for free-form questions.",
        questions_left: quotaSpend(),
      };
    }

    const { texts, meta } = await new Promise<AskResult>((resolve, reject) => {
      waiter = { resolve, reject };
      waiterTimeout = setTimeout(() => settleWaiter("reject", new Error("timeout")), ANSWER_TIMEOUT_MS);
      pending = true;
      outbox.push(JSON.stringify({ messages: [{ role: "user", text: question }] }));
      ensureConnected();
      if (ws && ws.readyState === WebSocket.OPEN) while (outbox.length) ws.send(outbox.shift()!);
    });

    return {
      answer: texts.join("\n\n"),
      official_answer: known?.official,
      // Prefer the live tool-call trace from this exact request — falls back to the
      // offline benchmark trace only if the server didn't return meta for some reason.
      trace: metaToTrace(meta) ?? known?.vedana.trace,
      chatgpt: known?.chatgpt,
      questions_left: quotaSpend(),
    };
  }

  /* ======================================================
     UI wiring
  ====================================================== */

  const el = (id: string) => document.getElementById(id)!;
  const startScreen = el("lv-start");
  const chatScreen = el("lv-chat");
  const doneScreen = el("lv-done");
  const thread = el("lv-thread");

  let questionsTotal = 12;

  function setQuota(left: number) {
    const started = thread.childElementCount > 0;
    el("lv-quota-text").textContent = started ? `${left} left` : `${left} questions`;
    el("lv-mode").innerHTML = started
      ? 'live demo · powered by <a href="/demo">Vedana</a>'
      : 'private demo · powered by <a href="/demo">Vedana</a>';
    if (left <= 0) {
      startScreen.hidden = true;
      chatScreen.hidden = thread.childElementCount === 0;
      // keep the last answer visible; the composer goes away, done-card follows the thread
      chatScreen.querySelector("form")?.setAttribute("hidden", "");
      el("lv-done-total").textContent = String(questionsTotal);
      doneScreen.hidden = false;
    }
  }

  function escapeHtml(s: string) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function addUserMessage(question: string, chip?: string) {
    const div = document.createElement("div");
    div.className = "lv-msg-user";
    div.innerHTML =
      (chip ? `<span class="lv-msg-user__chip">${escapeHtml(chip)}</span>` : "") +
      `<span class="lv-msg-user__bubble">${escapeHtml(question)}</span>`;
    thread.appendChild(div);
  }

  function verdictBadge(v: "PASS" | "PARTIAL" | "FAIL") {
    return `<span class="demo-status demo-status--${v.toLowerCase()}">${v}</span>`;
  }

  function addAnswer(a: Answer, fromSet: boolean, question: string) {
    const div = document.createElement("div");
    div.className = "lv-msg-vedana";

    const sources = extractSources(question, a.answer, a.official_answer);
    const sourcesHtml = sources.length
      ? `<p class="lv-msg-vedana__sources">
          <span class="lv-msg-vedana__sources-label">Sources:</span>
          ${sources.map((s) => `<a href="/demo/corpus/${s.slug}">${escapeHtml(s.label)}</a>`).join(" · ")}
        </p>`
      : "";

    const official = a.official_answer
      ? `<details class="lv-official" open><summary class="lv-official__label">Official answer · challenge key</summary><p class="lv-official__text">${escapeHtml(a.official_answer)}</p></details>`
      : "";

    const trace = a.trace
      ? `<details class="lv-trace"><summary>How Vedana found this</summary><div class="lv-trace__body">${escapeHtml(a.trace)}</div></details>`
      : "";

    const chatgpt = a.chatgpt
      ? `<details class="lv-trace lv-chatgpt-toggle">
          <summary>⇆ Compare to plain ChatGPT</summary>
          <div class="lv-chatgpt">
            <p class="lv-chatgpt__head">
              <span>ChatGPT · same question</span>
              ${verdictBadge(a.chatgpt.verdict)}
            </p>
            <p class="lv-official__text">${escapeHtml(a.chatgpt.answer)}</p>
            <p class="lv-chatgpt__diff"><strong>Difference:</strong> ${escapeHtml(a.chatgpt.comment)}</p>
          </div>
        </details>`
      : "";

    div.innerHTML = `
      <div class="lv-msg-vedana__head">
        <span class="lv-msg-vedana__avatar">V</span>
        <span class="lv-msg-vedana__name">Vedana</span>
        ${a.verdict ? `<span class="lv-msg-vedana__verdict">${verdictBadge(a.verdict)}</span>` : ""}
      </div>
      <p class="lv-msg-vedana__body">${escapeHtml(a.answer)}</p>
      ${sourcesHtml}
      ${fromSet ? official : ""}
      ${trace}
      ${fromSet ? chatgpt : ""}
    `;

    thread.appendChild(div);
  }

  // Only one question can be outstanding at a time — apiAsk's waiter/pending state is a single
  // module-level slot, so a second question fired while one is in flight would steal the first
  // one's answer (or leave its "thinking" bubble stuck forever). Lock input for the duration.
  let questionInFlight = false;

  function setInputLocked(locked: boolean) {
    document.querySelectorAll<HTMLButtonElement>(".lv-composer__send").forEach((b) => (b.disabled = locked));
    document.querySelectorAll<HTMLInputElement>(".lv-composer input").forEach((i) => (i.disabled = locked));
    document.querySelectorAll<HTMLButtonElement>(".lv-qtype__question").forEach((b) => (b.disabled = locked));
  }

  async function runQuestion(question: string, chip?: string) {
    if (questionInFlight) return;
    questionInFlight = true;
    setInputLocked(true);

    startScreen.hidden = true;
    chatScreen.hidden = false;

    addUserMessage(question, chip);

    const thinking = document.createElement("p");
    thinking.className = "lv-thinking";
    thinking.textContent = "Vedana is traversing the graph…";
    thread.appendChild(thinking);
    thinking.scrollIntoView({ behavior: "smooth", block: "end" });

    try {
      const answer = await apiAsk(question);
      thinking.remove();
      addAnswer(answer, Boolean(chip), question);
      setQuota(answer.questions_left);
    } catch (e) {
      thinking.remove();
      if (e instanceof Error && e.message === "invalid-token") {
        showInvalidLink("This link has expired or is no longer valid — ask for a fresh one.");
        chatScreen.querySelector("form")?.setAttribute("hidden", "");
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else if (e instanceof Error && e.message === "budget-exceeded") {
        showInvalidLink("This link has used up its question budget on the server — ask for a fresh one.");
        chatScreen.querySelector("form")?.setAttribute("hidden", "");
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else {
        const err = document.createElement("div");
        err.className = "lv-error";
        err.textContent = "Couldn't reach the demo server — try again, or ping us for a fresh link.";
        thread.appendChild(err);
      }
    } finally {
      questionInFlight = false;
      setInputLocked(false);
    }

    thread.lastElementChild?.scrollIntoView({ behavior: "smooth", block: "end" });
  }

  function wireComposer(form: HTMLFormElement) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector("input")!;
      const q = input.value.trim();
      if (!q) return;
      input.value = "";
      runQuestion(q, "your question");
    });
  }

  function showInvalidLink(message: string) {
    const banner = el("lv-no-token");
    banner.hidden = false;
    const text = banner.querySelector<HTMLElement>(".lv-no-token__text");
    if (text) text.textContent = message;
    el("lv-quota-text").textContent = "no link";
    startScreen.hidden = true;
  }

  // The server rejects the WebSocket handshake before accept() on an invalid token, which
  // browsers surface as a generic abnormal closure (no readable status code) — so we can't
  // tell "bad token" from "network hiccup" from the socket alone. Probe over plain HTTP first,
  // where a real 403 is readable, and only wire up the chat UI once that passes.
  async function verifyToken(): Promise<boolean> {
    if (mock) return true;
    try {
      const res = await fetch(
        `${SERVER}/api/history?contact_id=${encodeURIComponent(contactId)}&token=${encodeURIComponent(token ?? "")}&limit=1`,
      );
      if (res.status === 403) {
        showInvalidLink("This link has expired or is no longer valid — ask for a fresh one.");
        return false;
      }
      if (res.ok) {
        const data = await res.json();
        if (typeof data.cursor === "number") seenCount = data.cursor;
      }
      return true;
    } catch {
      // Network/CORS error: let the user try anyway — runQuestion() will surface a clear error.
      return true;
    }
  }

  async function init() {
    if (!token && !mock) {
      el("lv-no-token").hidden = false;
      el("lv-quota-text").textContent = "no link";
      return;
    }

    if (!(await verifyToken())) return;

    if (mock) localStorage.setItem(quotaKey, String(QUOTA_TOTAL));
    questionsTotal = QUOTA_TOTAL;
    el("lv-client").innerHTML = escapeHtml(clientName);
    el("lv-client-inline").innerHTML = escapeHtml(clientName);
    setQuota(quotaLeft());

    document.querySelectorAll<HTMLButtonElement>(".lv-qtype__head").forEach((head) => {
      head.addEventListener("click", () => {
        const card = head.closest(".lv-qtype")!;
        const body = card.querySelector<HTMLElement>(".lv-qtype__body")!;
        const isOpen = card.classList.toggle("is-open");
        body.hidden = !isOpen;
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".lv-qtype__question").forEach((btn) => {
      btn.addEventListener("click", () => {
        const label = btn.dataset.typeLabel ?? "";
        runQuestion(btn.dataset.question!, `from the set · ${label.charAt(0)}${label.slice(1).toLowerCase()}`);
      });
    });

    el("lv-back-to-set").addEventListener("click", () => {
      chatScreen.hidden = true;
      startScreen.hidden = false;
      window.scrollTo({ top: 0 });
    });

    wireComposer(document.getElementById("lv-composer-start") as HTMLFormElement);
    wireComposer(document.getElementById("lv-composer-chat") as HTMLFormElement);
  }

  init();
</script>
