---
import BaseLayout from "@/layouts/baseLayout.astro";
import DocsSidebar from "@/components/products/vedana/DocsSidebar.astro";
import Footer from "@/components/products/vedana/footer/Footer.astro";

import styles from "./DocsLayout.module.css";
import "../styles/global.css";

import { getDocsNavigation } from "@/lib/docs/navigation";

import type { SEOConfig } from "@/lib/seo/types";

interface Props {
  baseSEO?: SEOConfig;
  pageSEO?: Partial<SEOConfig>;
  structuredData?: object | object[];

  currentSlug?: string;
  headings?: any;

  title?: string;
  description?: string;
}

const {
  baseSEO,
  pageSEO,
  structuredData,

  currentSlug,
  headings,

  title,
  description,
} = Astro.props;

/* ======================================================
   NAVIGATION (SOURCE OF TRUTH)
====================================================== */

const sections = await getDocsNavigation();

/* ======================================================
   SEO BASE
====================================================== */

const safeBaseSEO: SEOConfig = baseSEO ?? {
  title: "Vedana Docs",
  description:
    "Documentation for Vedana — graph-first AI for enterprise decisions.",
  canonical: "https://vedana.tech/docs",

  og: {
    type: "website",
    image: "/og/vedana-docs.png",
    imageAlt: "Vedana Docs",
  },

  twitter: {
    card: "summary_large_image",
    image: "/og/vedana-docs.png",
  },
};

/* ======================================================
   PAGE SEO
====================================================== */

const safePageSEO: Partial<SEOConfig> = {
  ...(pageSEO ?? {}),
  ...(title && { title }),
  ...(description && { description }),
};
---

<BaseLayout
  baseSEO={safeBaseSEO}
  pageSEO={safePageSEO}
  structuredData={structuredData}
>
  <div class="page-root">

    <div class={styles.container}>
      
      <aside class={styles.sidebar}>
        <DocsSidebar
          sections={sections}
          currentSlug={currentSlug ?? ""}
        />
      </aside>

      <main class={styles.content}>
        <slot />
      </main>

    </div>

    <Footer />

  </div>
</BaseLayout>

<script>
  const blocks = document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]');

  if (blocks.length > 0) {
    const { default: mermaid } = await import("mermaid");

    mermaid.initialize({
      startOnLoad: false,
      theme: "neutral",
      fontSize: 13,
      flowchart: { useMaxWidth: true },
    });

    for (const pre of blocks) {
      const id = `mermaid-${Math.random().toString(36).slice(2)}`;

      try {
        const { svg } = await mermaid.render(id, pre.textContent ?? "");
        const div = document.createElement("div");
        div.className = "mermaid-diagram";
        div.innerHTML = svg;
        pre.replaceWith(div);
      } catch {
        pre.style.display = "block";
      }
    }
  }
</script>