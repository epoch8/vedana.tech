---
// Frame.astro — a drawn browser window around a product screenshot.
// Chrome bar (three traffic lights + URL pill) + the raw screenshot image.
// The image is rendered with a plain <img> using the asset's resolved src so
// the original PNG bytes ship unchanged (no <Image> re-encoding/resizing).
import type { ImageMetadata } from "astro";

interface Props {
  shot: ImageMetadata;
  url: string;
  alt?: string;
}

const { shot, url, alt = "" } = Astro.props;
---

<div class="media-frame">
  <div class="media-frame__chrome">
    <div class="media-frame__lights" aria-hidden="true">
      <span class="media-frame__light media-frame__light--red"></span>
      <span class="media-frame__light media-frame__light--amber"></span>
      <span class="media-frame__light media-frame__light--green"></span>
    </div>
    <div class="media-frame__url">{url}</div>
  </div>

  <div class="media-frame__viewport">
    <img
      class="media-frame__img"
      src={shot.src}
      width={shot.width}
      height={shot.height}
      alt={alt}
      loading="eager"
      decoding="sync"
    />
  </div>
</div>

<style>
  .media-frame {
    width: 100%;
    background: #ffffff;
    border: 1px solid hsl(220 25% 88%);
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 40px 80px rgba(15, 23, 42, 0.18),
      0 12px 28px rgba(15, 23, 42, 0.1);
  }

  .media-frame__chrome {
    position: relative;
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 16px;
    background: linear-gradient(180deg, #fbfcfe, #f1f4f9);
    border-bottom: 1px solid hsl(220 25% 90%);
  }

  .media-frame__lights {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .media-frame__light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .media-frame__light--red {
    background: #ff5f57;
  }
  .media-frame__light--amber {
    background: #febc2e;
  }
  .media-frame__light--green {
    background: #28c840;
  }

  .media-frame__url {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    max-width: 60%;
    padding: 5px 16px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid hsl(220 25% 90%);

    font-size: 13px;
    line-height: 1;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .media-frame__viewport {
    display: block;
    background: #ffffff;
  }

  .media-frame__img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
