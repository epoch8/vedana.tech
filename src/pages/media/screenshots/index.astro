---
import MediaLayout from "@/layouts/MediaLayout.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("screenshots")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<MediaLayout title="Vedana — media screenshots">
  <main class="index">
    <header class="index-head">
      <img
        class="index-logo"
        src="/brand/vedana-logo-horizontal.svg"
        alt="Vedana"
        width="160"
        height="48"
      />
      <h1 class="index-title">Media screenshots</h1>
      <p class="index-sub">
        Internal — render targets for Product Hunt, landing, and social. Each
        card opens a 1270×760 capture stage.
      </p>
    </header>

    <ul class="index-grid">
      {
        items.map((item) => (
          <li class="index-card">
            <a href={`/media/screenshots/${item.id}`}>
              <div class="index-thumb">
                <img
                  src={item.data.shot.src}
                  width={item.data.shot.width}
                  height={item.data.shot.height}
                  alt={item.data.title}
                  loading="lazy"
                />
              </div>
              <div class="index-meta">
                <span class="index-order">
                  {String(item.data.order).padStart(2, "0")}
                </span>
                <span class="index-card-title">{item.data.title}</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</MediaLayout>

<style>
  .index {
    max-width: 1100px;
    margin: 0 auto;
    padding: 64px 24px 96px;
  }

  .index-head {
    text-align: center;
    margin-bottom: 48px;
  }
  .index-logo {
    height: 32px;
    width: auto;
    margin-bottom: 20px;
  }
  .index-title {
    margin: 0 0 8px;
    font-size: 28px;
    color: var(--color-text-strong);
  }
  .index-sub {
    margin: 0 auto;
    max-width: 560px;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .index-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .index-card a {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid hsl(220 25% 90%);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .index-card a:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.12);
  }

  .index-thumb {
    aspect-ratio: 1270 / 760;
    background: #f1f4f9;
    overflow: hidden;
    border-bottom: 1px solid hsl(220 25% 92%);
  }
  .index-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .index-meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 14px 16px;
  }
  .index-order {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--color-primary);
    font-size: 14px;
  }
  .index-card-title {
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-text);
  }
</style>
